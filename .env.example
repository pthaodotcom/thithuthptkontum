# === Supabase ===
# Lay tai Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chi dung o server (API routes, cron) - KHONG duoc lo ra client
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > API > JWT Settings > JWT Secret - dung de tu ky JWT dang nhap (xem lib/auth/jwt.ts)
SUPABASE_JWT_SECRET=

# === Auth ===
# Cookie session ky/ma hoa, tu sinh: `openssl rand -base64 32`
SESSION_COOKIE_SECRET=

# === Gemini API (FR-M6-02) ===
# Lay tai Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Kiem tra model GA moi nhat truoc khi deploy Phase 5, xem ke-hoach-trien-khai-webapp.md muc 1
GEMINI_MODEL=gemini-3.5-flash

# === Gmail SMTP (FR-M5-07) ===
# Tai khoan Gmail phai bat xac minh 2 buoc va tao App Password.
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=He thong Thi thu THPT
GMAIL_REPLY_TO=
# false (mac dinh) = stub/log, khong gui email that
EMAIL_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Gmail API OAuth 2.0 (khuyen nghi khi khong co App Password) ===
EMAIL_PROVIDER=gmail-api
GMAIL_SENDER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# === Cron ===
# Secret dung de xac thuc request tu Vercel Cron vao route /api/cron/*
CRON_SECRET=

# === Playwright smoke test Realtime (chi dung project dev/test) ===
E2E_BASE_URL=http://127.0.0.1:3000
E2E_ADMIN_MA_SO=
E2E_ADMIN_MAT_KHAU=
E2E_HOC_SINH_MA_SO=
E2E_HOC_SINH_MAT_KHAU=
# Ba bai DangThi rieng biet; bai submit se ket thuc sau test.
E2E_VI_PHAM_BAI_LAM_ID=
E2E_POLLING_BAI_LAM_ID=
E2E_SUBMIT_BAI_LAM_ID=
